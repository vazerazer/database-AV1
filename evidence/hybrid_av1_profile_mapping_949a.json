  },
  "tier_definitions": {
    "Tier 1": {
      "tier_name": "Preferred AV1",
      "priority_level": 1,
      "member_groups": ["ChopperHitler", "CoSMiCSuRFeR"],
      "confidence_state": "candidate",
      "evidence_basis_allowed": ["same-master-reference", "hallowed-relative"],
      "selection_behavior": "Preferred over all other tiers when available and technical parity is credible.",
      "score_band": ">= 2300"
    },
    "Tier 2": {
      "tier_name": "Review AV1 Fallback (Guarded)",
      "priority_level": 2,
      "member_groups": ["RandH", "Smokindevil", "Rob74K"],
      "confidence_state": "review",
      "evidence_basis_allowed": ["same-master-reference", "hallowed-relative"],
      "selection_behavior": "Allowed as fallback when Tier 1 is absent, provided title passes concrete quality/bitrate guardrails; demoted to Tier 4 if guardrails fail.",
      "score_band": "1500 - 2000"
    },
    "Tier 3": {
      "tier_name": "x265 Reference Fallback",
      "priority_level": 3,
      "member_groups": ["hallowed", "Dumpstarr 4K", "MainFrame", "Framestor", "NTb", "FLUX", "BHDStudio"],
      "confidence_state": "reference-baseline",
      "evidence_basis_allowed": ["same-master-reference", "none"],
      "selection_behavior": "Preferred over Tier 4 and over Tier 2 when review AV1 fails guardrails; secondary fallback when Tier 1 AV1 is unavailable.",
      "score_band": "1000 - 1400"
    },
    "Tier 4": {
      "tier_name": "Last-Resort AV1 / Quarantine",
      "priority_level": 4,
      "member_groups": ["Bi0hazard", "Waldek", "SHADOW", "Untrusted/Unmeasured Groups"],
      "confidence_state": "unmeasured",
      "evidence_basis_allowed": ["none", "insufficient-parity", "hallowed-relative"],
      "selection_behavior": "Quarantined; selected only when no Tier 1, Tier 2, or Tier 3 releases exist in pool; lowest priority.",
      "score_band": "0 - 400"
    }
  },
